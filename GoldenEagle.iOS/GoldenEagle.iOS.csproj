<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>uk.co.allthejohnsons.goldeneagle</ApplicationId>
    <ApplicationTitle>Golden Eagle</ApplicationTitle>
    <ApplicationVersion>$(BuildNumber)</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <RootNamespace>GoldenEagle.iOS</RootNamespace>
    <AssemblyName>GoldenEagle</AssemblyName>
    <AppIcon>AppIcon</AppIcon>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>
  <!-- Profiles are installed locally (not in git): devel-goldeneagle for devices, rel-goldeneagle-ios for the App Store. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CodesignKey>Apple Development: Paul Johnson (WFWPL93CN6)</CodesignKey>
    <CodesignProvision>devel-goldeneagle</CodesignProvision>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <CodesignKey>Apple Distribution: Paul Johnson (3UH7BE38T3)</CodesignKey>
    <CodesignProvision>rel-goldeneagle-ios</CodesignProvision>
    <ArchiveOnBuild>true</ArchiveOnBuild>
    <BuildIpa>true</BuildIpa>
  </PropertyGroup>
  <ItemGroup>
    <!-- Localised home-screen name: "L'Aigle d'Or" in French. -->
    <BundleResource Include="Resources\**\*.strings" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GoldenEagle.Core\GoldenEagle.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.iOS" Version="$(MonoGameVersion)" />
  </ItemGroup>
</Project>
