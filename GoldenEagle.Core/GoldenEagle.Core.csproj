<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GoldenEagle.Core</RootNamespace>
    <AssemblyName>GoldenEagle.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile against MonoGame only; each platform head supplies its own MonoGame runtime. -->
    <PackageReference Include="MonoGame.Framework.Native" Version="$(MonoGameVersion)">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- High-resolution artwork drawn by tools/make_art.py, loaded by name at run time. -->
    <EmbeddedResource Include="Art\*.png" LogicalName="Art.%(Filename).png" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GoldenEagle.Tests" />
  </ItemGroup>
</Project>
